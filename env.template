# Temporal Workflow API Configuration
# Copy this file to .env and customize for your environment

# =============================================================================
# API Server Configuration
# =============================================================================

# Host and port for the API server
# Use 0.0.0.0 for Docker containers, 127.0.0.1 for local dev
API_HOST=0.0.0.0
API_PORT=8000

# IPs/CIDRs of proxies (load balancer, ingress gateway) trusted to set
# X-Forwarded-For, used to resolve the real client IP for the auth-failure
# rate limiter. Defaults to 127.0.0.1 - safe when nothing fronts the app.
#
# Only widen this to your real gateway's address range if a NetworkPolicy
# (or equivalent) also restricts direct access to this app to just that
# gateway. Without that restriction, any other pod able to reach this app
# on the trusted network/CIDR can also forge X-Forwarded-For and defeat
# the rate limiter - this value alone does not provide isolation.
TRUSTED_PROXY_HOSTS=127.0.0.1

# Optional: largest request body accepted, in bytes (larger requests get
# HTTP 413). Leave unset to use foundry-agent-core's shared dict byte cap
# (_MAX_DICT_BYTES), so a change to the shared limit applies automatically.
# Set it only to override that default for this deployment, for example:
# MAX_REQUEST_BODY_BYTES=8388608

# Optional: seconds each health check may spend on Temporal before giving up
# (default 0.9), covering both waiting for the connection and the probe query.
# A slower first connection keeps going in the background and later checks
# reuse it. Keep it below your readiness probe's own timeout (Kubernetes
# timeoutSeconds, default 1).
# TEMPORAL_PROBE_TIMEOUT_SECONDS=0.9

# Optional: time limit in seconds for one connect to Temporal (default 30).
# A connect that takes longer fails, so the next request starts a fresh one
# instead of waiting on a connect that will never finish. Workflow requests
# during a stuck connect answer 503 once the limit passes.
# TEMPORAL_CONNECT_TIMEOUT_SECONDS=30

# Optional: readiness probe timeouts in a row on the same cached Temporal client
# before it is discarded and the next request connects again (default 3, at
# least 1). Raise it if Temporal is often slow under load.
# TEMPORAL_PROBE_TIMEOUTS_BEFORE_RECONNECT=3

# Bearer token required for /workflows/* endpoints (fail-closed when unset).
# Generate with: uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
API_AUTH_TOKEN=

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# =============================================================================
# Temporal Configuration
# =============================================================================

# Temporal server host and port, for `just dev` on your machine. compose.yaml sets
# host.docker.internal:7233 for the API container itself.
TEMPORAL_HOST=localhost:7233

# Temporal namespace
TEMPORAL_NAMESPACE=default

# Default task queue for workflows started through the API
TEMPORAL_TASK_QUEUE=workflow-task-queue

# TLS posture for Temporal connections (platform, tls, mtls, or off)
# platform means the platform or service mesh terminates TLS.
# off means no TLS at all, for a local Temporal server. It behaves like platform.
# The API refuses to start with off when ENVIRONMENT=production.
# tls means one-way TLS. The server is verified against system root CAs,
# or against TEMPORAL_TLS_CA when it is set.
# mtls means mutual TLS. It needs TEMPORAL_TLS_CERT and TEMPORAL_TLS_KEY.
TEMPORAL_TLS_MODE=platform

# Paths to PEM files for tls or mtls. Set the cert and key together, or
# neither. The CA is optional. Blank values are treated as unset. Under tls
# or mtls each path that is set must be a readable file, or startup stops.
# Under platform or off these are ignored.
#TEMPORAL_TLS_CERT=/certs/client.pem
#TEMPORAL_TLS_KEY=/certs/client.key
#TEMPORAL_TLS_CA=/certs/ca.pem
